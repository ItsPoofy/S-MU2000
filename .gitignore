build/
build-*/
# The signing team for the iOS build (make ios-team-id writes it). Ten hex
# characters, no secret - but it is per machine, so it does not belong in a
# checkout.
.ios-team-id
*.o
*.a
*.exe
*.wav
roms/

# web/ build outputs and deps (rebuild with npm run build in web/)
web/out/
web/node_modules/
web/dist/

# JetBrains configuration files
.idea/

# 同じところで MAME を走らせたときに出るもの
cfg/
nvram/
snap/
__pycache__/
# MIDI files may come with incompatible licenses; keep them local
*.mid
# フォントの実体。fc_match_probe.sh の検証用なので追跡しない
fonts/
