<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  iOS entitlements for the AUv3 extension.

	  Deliberately no application-groups. Working without a paid account means free
	  provisioning, which does not support App Groups, so the extension cannot reach
	  the app's files through a shared container. The ROMs are therefore baked into
	  the extension bundle instead (make ios-auv3 IOS_ROMS=roms), which the engine
	  already finds: engine.cpp searches module_dir()/../Resources/roms, and that is
	  correct for both layouts - macOS puts the binary in Contents/MacOS and iOS is
	  flat, so in both cases the bundle's Resources is one level up from the binary.

	  "import ROMs" from inside the app can come later; it would write into this same
	  bundle-adjacent directory or, once there is a paid account, into a group
	  container.

	  allow-jit: kept for completeness. It does nothing on iOS, where
	  pthread_jit_write_protect_np is unavailable (src/compat/exec_mem.h gates it on
	  !TARGET_OS_IPHONE) and the engine runs the interpreter, which is fully working.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>